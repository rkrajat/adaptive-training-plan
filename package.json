{
  "name": "adaptive-training-plan",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive Training Plan - An online platform that helps runners intelligently adjust their training plans based on recent performance and health data",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "apps/api/src/**/*.{ts,tsx}": "pnpm --filter=api lint --fix",
    "apps/web/**/*.{ts,tsx}": "pnpm --filter=web lint --fix"
  }
}
